generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id         String       @id @default(cuid())
  name       String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  owner      Owner[]
  restaurant Restaurant[]
}

model Owner {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  role           String
  username       String           @unique
  hashedPassword String
  hashedPin      String
  companyId      String
  subscription   subscriptionPlan
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  branch         Branch[]
  company        Company          @relation(fields: [companyId], references: [id])
  restaurant     Restaurant[]
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  companyId String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
  company   Company  @relation(fields: [companyId], references: [id])
  owner     Owner    @relation(fields: [ownerId], references: [id])
  staff     Staff[]
}

model Branch {
  id             String          @id @default(cuid())
  name           String
  location       String?
  ownerId        String
  restaurantId   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  owner          Owner           @relation(fields: [ownerId], references: [id])
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id])
  menus          Menu[]
  orders         Order[]
  packages       Package[]
  paymentMethods PaymentMethod[]
  staff          Staff[]
  tables         Table[]
  zone           Zone[]
  reservations Reservation[]
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int
  imageUrl    String?
  imageId     String?

  branchId    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch       Branch?            @relation(fields: [branchId], references: [id])
  packageItems PackageMenuItem[]
  diningSession DiningSession[]
}

model PackageMenuItem {
  id         String   @id @default(cuid())

  packageId  String
  menuItemId String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([packageId, menuItemId])
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff[]
  tables    Table[]
  branch    Branch?  @relation(fields: [branchId], references: [id])
}

model Staff {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  role           StaffRole
  restaurantId   String
  branchId       String
  zoneId         String?
  username       String     @unique
  hashedPassword String
  hashedPin      String
  status         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  branch         Branch     @relation(fields: [branchId], references: [id])
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  zone           Zone?       @relation(fields: [zoneId], references: [id])

  startedSessions DiningSession[] @relation("SessionStartedBy")
  closedSessions DiningSession[] @relation("SessionClosedBy")

  createdOrders Order[] @relation("OrderCreatedBy")
  cashierPayments Payment[] @relation("PaymentCashier")
  reservations Reservation[]
}


model Table {
  id           String         @id @default(cuid())
  tableNumber  String
  capacity     Int
  status       TableStatus    @default(available)
  qr           String?         @unique
  branchId     String
  zoneId       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  order        Order[]
  branch       Branch         @relation(fields: [branchId], references: [id])
  zone         Zone           @relation(fields: [zoneId], references: [id])
  diningSessions DiningSession[]
  reservations Reservation[]

  @@unique([branchId, tableNumber])
}

model DiningSession {
  id            String    @id @default(cuid())
  tableId       String
  packageId     String?
  package       Package? @relation(fields:[packageId], references:[id])

  reservationId String? @unique
  reservation Reservation? @relation("ReservationSession", fields: [reservationId], references: [id])

  status        DiningStatus @default(seated)
  guestCount    Int

  startedAt DateTime @default(now())
  closedAt DateTime?
  finishedAt DateTime?

  startedById String
  closedById String?

  bill       Bill?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  
  table         Table     @relation(fields: [tableId], references: [id])
  startedBy Staff @relation( "SessionStartedBy",fields:[startedById], references:[id])

  closedBy Staff? @relation("SessionClosedBy",fields:[closedById], references:[id])

  @@index([tableId])
  @@index([status])
}

model Menu {
  id         String     @id @default(cuid())
  name       String
  branchId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categories Category[]
  branch     Branch     @relation(fields: [branchId], references: [id])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  menuId      String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menu        Menu       @relation(fields: [menuId], references: [id])
  items       MenuItem[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  price       Decimal
  description String?

  status      menuStatus @default(available)
  imageUrl    String?
  imageId     String?

  categoryId  String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     Category          @relation(fields: [categoryId], references: [id])
  orderItems   OrderItem[]
  packageItems PackageMenuItem[]
}


model Order {
  id          String        @id @default(cuid())
  branchId    String
  tableId     String?
  diningSessionId   String?

  createdById String?
  createdBy Staff? @relation("OrderCreatedBy", fields: [createdById], references: [id])

  status      OrderStatus   @default(pending)
  totalAmount Decimal       @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  branch      Branch        @relation(fields: [branchId], references: [id])
  diningSession DiningSession?  @relation(fields: [diningSessionId], references: [id])
  table       Table?        @relation(fields: [tableId], references: [id])
  items       OrderItem[]
  @@index([diningSessionId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  note        String?
  quantity   Int
  price      Decimal
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model PaymentMethod {
  id        String    @id @default(cuid())
  name      String
  branchId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payment   Payment[]
  branch    Branch    @relation(fields: [branchId], references: [id])
}

model Bill {
  id  String @id @default(cuid())
  sessionId  String  @unique

  diningSession DiningSession @relation(fields:[sessionId], references:[id])

  subtotal Decimal
  discount Decimal @default(0)
  serviceChargeRate Decimal @default(5)
  serviceCharge Decimal @default(0)
  taxRate Decimal @default(7)
  tax Decimal @default(0)

  grandTotal Decimal
  status BillStatus

  receiptNumber String @unique

  payments Payment[]

  createdAt DateTime @default(now())
  paidAt DateTime?
}

model Payment {
  id              String   @id @default(cuid())

  billId          String
  bill            Bill @relation(fields: [billId], references: [id])

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  amount          Decimal

  paidAt          DateTime @default(now())
  status          PaymentStatus @default(pending)
  referenceNo String?

  cashierId String?
  cashier Staff? @relation("PaymentCashier", fields: [cashierId], references: [id])
  @@index([billId])
}

model Reservation {
  id             String @id @default(cuid())
  tableId        String?
  branchId       String

  customerName   String
  customerPhone  String
  customerEmail  String?

  guestCount     Int

  reservedAt     DateTime  
  reservedTime   DateTime 
  seatedAt DateTime?      

  status         ReservationStatus @default(pending)

  note           String?

  createdById    String?     

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  diningSession DiningSession? @relation("ReservationSession")

  table          Table? @relation(fields: [tableId], references: [id])
  createdBy      Staff? @relation(fields: [createdById], references: [id])
  branch        Branch  @relation(fields: [branchId], references: [id])

  @@index([branchId, reservedAt])
  @@index([tableId, reservedAt])
  @@index([status])
}

enum ReservationStatus {
  pending
  confirmed
  arrived
  completed
  cancelled
  noShow
}

enum OrderStatus {
  pending
  preparing
  served
  completed
  cancelled
}

enum StaffRole {
  owner
  manager
  front_staff
  cashier
  kitchen
}

enum TableStatus {
  available
  reserved
  occupied
  need_attention
  request_bill
  cleaning
  maintenance
}

enum BillStatus {
    unpaid
    partiallyPaid
    paid
    refunded
    void
}

enum PaymentStatus {
  pending

  paid

  failed

  refunded
}

enum subscriptionPlan {
  free
  basic
  bronze
  silver
  gold
}

enum menuStatus {
  available
  soldOut
}

enum DiningStatus {
  seated
  ordering
  dining
  finishedEating
  paying
  completed
  cancelled
}
